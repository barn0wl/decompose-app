generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────

enum StopType {
  taxi_stop
  gbaka_station
  landmark
  zone_boundary
}

enum TransportType {
  communal_taxi
  gbaka
  sotra_bus
  walking
}

enum SuggestionStatus {
  pending
  approved
  rejected
  auto_rejected
}

// ─── MODELS ──────────────────────────────────────────────────────────────

model Stop {
  id        String   @id @default(uuid())
  name      String
  commune   String
  latitude  Float
  longitude Float
  type      StopType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Native PostGIS geography column, auto-maintained by a DB trigger
  // from latitude/longitude. Managed only via raw SQL migrations —
  // Prisma Migrate ignores Unsupported() columns, so it won't try to
  // "reconcile" this back to text again.
  geom      Unsupported("geography(Point, 4326)")?

  connectionsFrom Connection[] @relation("FromStop")
  connectionsTo   Connection[] @relation("ToStop")
  suggestedFrom   SuggestedConnection[] @relation("SuggestionFrom")
  suggestedTo     SuggestedConnection[] @relation("SuggestionTo")

  segmentsAsFrom  RouteSegment[] @relation("SegmentFrom")
  segmentsAsTo    RouteSegment[] @relation("SegmentTo")
}

model Vote {
  id           String   @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deviceId     String
  vote         Int      @db.SmallInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([connectionId, deviceId])
  @@index([deviceId])
  @@index([connectionId])
  @@index([createdAt])
}

model Connection {
  id String @id @default(uuid())

  fromStopId String
  fromStop   Stop  @relation("FromStop", fields: [fromStopId], references: [id])

  toStopId String
  toStop   Stop  @relation("ToStop", fields: [toStopId], references: [id])

  transportType    TransportType
  basePrice        Int
  durationMinutes  Int
  routeDescription String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  upvotes          Int    @default(0)
  downvotes        Int    @default(0)
  voteScore        Int    @default(0)

  votes Vote[]
}

// ─── SUGGESTED CONNECTION  ─────────────────────────────────────────

model SuggestedConnection {
  id String @id @default(uuid())

  fromStopId      String
  fromStop        Stop           @relation("SuggestionFrom", fields: [fromStopId], references: [id])
  toStopId        String
  toStop          Stop           @relation("SuggestionTo", fields: [toStopId], references: [id])
  transportType   TransportType
  basePrice       Int
  durationMinutes Int
  routeDescription String?

  submittedBy     String
  submittedAt     DateTime       @default(now())
  status          SuggestionStatus @default(pending)
  confirmations   Int            @default(0)
  confirmationThreshold Int      @default(5)
  confirmedBy     Json?
  rejectedBy      String?
  rejectedReason  String?
  rejectedAt      DateTime?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ─── ROUTE (new transit model) ────────────────────────────────────────────

model Route {
  id              String          @id @default(uuid())
  name            String
  transportType   TransportType

  // Pricing rule stored as JSON. Shape (typed in code):
  //   { type: 'flat', price: number }
  //   { type: 'banded', bands: [{ uptoSequence: number, price: number }] }
  pricing         Json

  // Total number of stops on the route (used for reverse-direction pricing math)
  totalStops      Int

  segments        RouteSegment[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([transportType])
}

model RouteSegment {
  id              String  @id @default(uuid())
  routeId         String
  route           Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  fromStopId      String
  fromStop        Stop    @relation("SegmentFrom", fields: [fromStopId], references: [id])

  toStopId        String
  toStop          Stop    @relation("SegmentTo", fields: [toStopId], references: [id])

  // 0-indexed position within the route. Segment 0 connects stop[0] → stop[1].
  sequence        Int

  // Base duration in minutes (before traffic multiplier)
  durationMinutes Int

  @@unique([routeId, sequence])
  @@index([fromStopId])
  @@index([toStopId])
  @@index([routeId])
}
